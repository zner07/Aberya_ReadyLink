PORT=3000

# 127.0.0.1 = reachable only from this computer (recommended for development).
# Do not use 0.0.0.0 unless you deliberately want other devices on your network to connect.
HOST=127.0.0.1

# development | test | production
NODE_ENV=development

# Optional. Absolute path of the frontend folder.
# Default is the repository root, which already contains index.html, css/, js/ and data/.
# FRONTEND_DIR=

# --- Database and uploads (Phase 1) ---------------------------------------------------------
# auto = use better-sqlite3 if it installed correctly, otherwise the SQLite built into Node.js (node:sqlite).
# Other values: better-sqlite3 | node-sqlite
DB_DRIVER=auto

# Database file. A relative path is relative to the "server" folder. Never commit it (it is in .gitignore).
DB_FILE=data/readylink.db

# Folder for uploaded photos. A relative path is relative to the "server" folder. Never commit it.
UPLOADS_DIR=uploads

# Largest accepted photo in bytes (5 MB = 5242880). Allowed range: 1024 to 20971520.
MAX_PHOTO_BYTES=5242880

# --- Admin login (Phase 3.5) --------------------------------------------------------------------
# There is NO default admin account. Until you set one up, nobody can sign in or change reports.
# Do NOT type these by hand. Run this in the server folder and answer the questions:
#       npm.cmd run admin:setup
# It writes the three lines below for you. ADMIN_PASSWORD_HASH is a hash, never the password.
# Keep this file private: never commit it, never paste it in chat, never put these values in frontend files.
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=

# How long a login lasts, in hours (0.25 to 72). Logging out ends it at once. Restarting the server ends all logins.
ADMIN_SESSION_HOURS=8

# A second switch for admin changes (status, level, remarks). A logged-in admin is still needed.
#   auto = allowed only when HOST is 127.0.0.1 / localhost and NODE_ENV is not production (recommended)
#   on   = always allowed (use only with HTTPS in front of the server)
#   off  = never allowed (the admin pages become read-only)
ADMIN_WRITES=auto

# --- Place search for the report form (Phase 3.5) -------------------------------------------------
# The page asks THIS server, and this server asks a free public map service. It needs internet.
# The text a user types in the search box is sent to that service. Do not use it for private data.
#   photon    = photon.komoot.io (OpenStreetMap data, made for search-as-you-type) - default
#   nominatim = nominatim.openstreetmap.org (search only when the user presses Search; its rules forbid typeahead)
#   off       = no place search (the report form still has GPS, the map and photo location)
GEOCODER=photon
# Optional. Use another address (for example your own Photon server).
# GEOCODER_URL=
# Optional. An email address the map service can reach you on, if you use it a lot (Nominatim asks for this).
# GEOCODER_CONTACT=
GEOCODER_TIMEOUT_MS=5000

# --- AI-assisted hazard classification (AI Phase 1) -----------------------------------------------
# Runs on THIS server only. Never put API keys in frontend files or commit server/.env to git.
#   gemini = Google Gemini Developer API (falls back safely if GEMINI_API_KEY is empty)
#   off    = disable external AI calls and always use local safe fallback
AI_PROVIDER=gemini
# Optional. Paste your Google AI Studio Gemini API key in your private server/.env file:
# GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=8000